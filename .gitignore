# ============================================
# WordPress開発環境用 .gitignore
# ============================================

# ============================================
# 環境変数ファイル
# ============================================
.env
.env.local
.env.*.local

# ============================================
# WordPress Core（マウントされているため除外）
# ============================================
www/htdocs/wp-admin/
www/htdocs/wp-includes/
www/htdocs/wp-*.php
!www/htdocs/wp-config.sample.php
www/htdocs/xmlrpc.php
www/htdocs/readme.html
www/htdocs/license.txt
www/htdocs/index.php

# ============================================
# WordPress設定ファイル
# ============================================
www/htdocs/wp-config.php
www/htdocs/wp-config.php.bak
# .htaccess はセキュリティ設定テンプレとして追跡する

# ============================================
# Composer
# ============================================
# vendorディレクトリは除外（依存関係はcomposer installで取得）
# すべてのvendorディレクトリを再帰的に除外
**/vendor/
vendor/
www/htdocs/vendor/
www/htdocs/wp-content/**/vendor/

# composer.lockは含める（依存関係のバージョンを固定するため）
# 注意: composer.lockはGitに含めるべきファイルです

# ============================================
# Node.js / npm
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# ============================================
# ビルド成果物
# ============================================
dist/
build/
*.zip
*.tar.gz

# ============================================
# ログファイル
# ============================================
*.log
logs/
www/htdocs/wp-content/debug.log
www/htdocs/wp-content/*.log

# 設置用ログディレクトリ（.htaccess と空の debug.log だけ追跡）
# 実行時に増えたログは無視。デプロイは *.log 除外で上書きしない
www/htdocs/log/*
!www/htdocs/log/.htaccess
!www/htdocs/log/debug.log

# ============================================
# データベース
# ============================================
*.sql
*.sqlite
*.db

# ============================================
# 一時ファイル
# ============================================
*.tmp
*.temp
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.project
.idea/
.vscode/
.claude/
*.sublime-project
*.sublime-workspace

# ============================================
# WordPressアップロードファイル
# ============================================
# アップロードファイルはマウントされているため、永続化されます
# uploadsディレクトリ内のファイルは除外（.gitkeepは含める）
www/htdocs/wp-content/uploads/*
!www/htdocs/wp-content/uploads/.gitkeep

# ============================================
# EWWW Image Optimizer
# ============================================
# ewwwディレクトリ内のファイルは除外（.gitkeepは含める）
www/htdocs/wp-content/ewww/*
!www/htdocs/wp-content/ewww/.gitkeep

# ============================================
# WordPressプラグイン
# ============================================
# プラグインはマウントされているため、インストールされたプラグインは永続化されます
# プラグインディレクトリ全体を除外（.gitkeepは含める）
www/htdocs/wp-content/plugins/*
!www/htdocs/wp-content/plugins/composer.json
!www/htdocs/wp-content/plugins/composer.lock

# ============================================
# WordPress言語パック
# ============================================
# 言語パックはマウントされているため、インストールされた言語パックは永続化されます
# 言語パックディレクトリ内のファイルは除外（.gitkeepは含める）
www/htdocs/wp-content/languages/*
!www/htdocs/wp-content/languages/.gitkeep

# ============================================
# テーマ開発環境
# ============================================
# テーマ内の開発環境ファイル
www/htdocs/wp-content/themes/*/src/
www/htdocs/wp-content/themes/*/dev/
www/htdocs/wp-content/themes/*/node_modules/
www/htdocs/wp-content/themes/*/yarn.lock
www/htdocs/wp-content/themes/*/pnpm-lock.yaml
www/htdocs/wp-content/themes/*/.env
www/htdocs/wp-content/themes/*/.env.local
www/htdocs/wp-content/themes/*/dist/
www/htdocs/wp-content/themes/*/assets/.vite/
www/htdocs/wp-content/themes/*/tsconfig.tsbuildinfo

# ============================================
# Docker関連
# ============================================
.docker/
# ダンプファイル（エクスポートされたファイル）
docker/dump/*
!docker/dump/.gitkeep
# ログディレクトリ（すべてのファイルを除外）
docker/log/*
!docker/log/.gitkeep

